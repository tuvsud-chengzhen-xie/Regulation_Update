# Copy to .env and adjust. Every value has a working default.

# --- storage ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/standards.db

# --- extraction ------------------------------------------------------------
# Extraction is always live: every run fetches the real standards-body URLs.
HTTP_TIMEOUT_SECONDS=60
LIVE_FETCH_DELAY_SECONDS=1.5

# --- browser-assisted fetching ---------------------------------------------
# ISO, BIFMA, ALI and WSTDA build their listings client-side and sit behind an
# interstitial check, so they are read through a real headless Chromium.
# Requires: pip install playwright && python -m playwright install chromium
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=60
# How long to let a site's own interstitial finish before giving up.
BROWSER_CHALLENGE_WAIT_SECONDS=25
# How long to wait for the listing to appear once the page is through.
BROWSER_CONTENT_WAIT_SECONDS=20

# --- monitoring frequency (spec says "TBD"; default is monthly) ------------
SCHEDULER_ENABLED=false
SCHEDULE_CRON_DAY=1
SCHEDULE_CRON_HOUR=2
SCHEDULE_CRON_MINUTE=0

# --- email alerts ----------------------------------------------------------
# "console" writes each alert to data/outbox/ instead of sending it.
EMAIL_BACKEND=console
EMAIL_FROM=standards-monitor@tuvsud.com
# SMTP_HOST=smtp.tuvsud.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- access control --------------------------------------------------------
# The bootstrap administrator is created on first startup. Change the key
# before any non-local deployment.
BOOTSTRAP_ADMIN_EMAIL=chengzhen.xie@tuvsud.com
BOOTSTRAP_ADMIN_API_KEY=admin-demo-key

# --- AI training-data capture ----------------------------------------------
TRAINING_CAPTURE_ENABLED=true
TRAINING_SCHEMA_VERSION=1.1.0
